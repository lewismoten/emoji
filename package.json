{
  "name": "@lewismoten/emoji",
  "version": "4.2.5",
  "description": "list of named emoji unicode values",
  "type": "module",
  "main": "./dist/commonjs/popular.min.cjs",
  "types": "./dist/esm/types/popular.d.mts",
  "module": "./dist/esm/popular.min.js",
  "sideEffects": false,
  "engines": {
    "node": ">=22.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/esm/types/popular.d.mts",
      "import": "./dist/esm/popular.min.js",
      "require": "./dist/commonjs/popular.min.cjs"
    },
    "./popular": {
      "types": "./dist/esm/types/popular.d.mts",
      "import": "./dist/esm/popular.min.js",
      "require": "./dist/commonjs/popular.min.cjs"
    },
    "./all": {
      "types": "./dist/esm/types/all.d.mts",
      "import": "./dist/esm/all.min.js",
      "require": "./dist/commonjs/all.min.cjs"
    },
    "./categories/*": {
      "types": "./dist/esm/types/categories/*.d.mts",
      "import": "./dist/esm/categories/*.min.js",
      "require": "./dist/commonjs/categories/*.min.cjs"
    },
    "./variations/*": {
      "types": "./dist/esm/types/variations/*.d.mts",
      "import": "./dist/esm/variations/*.min.js",
      "require": "./dist/commonjs/variations/*.min.cjs"
    },
    "./manifest": "./dist/manifest.json",
    "./manifest.json": "./dist/manifest.json",
    "./search": {
      "types": "./dist/esm/types/search.d.mts",
      "import": "./dist/esm/search.min.js",
      "require": "./dist/commonjs/search.min.cjs"
    },
    "./locales/*": "./src/data/locales/*.json",
    "./orders/*": "./src/data/orders/*.json",
    "./versions/*": "./src/data/versions/*.json",
    "./proposed/*": "./src/data/proposed/*.json",
    "./development/*": {
      "types": "./dist/esm/types/*.d.mts",
      "import": "./dist/esm/*.js",
      "require": "./dist/commonjs/*.cjs"
    }
  },
  "scripts": {
    "clean": "node ./scripts/clean-build-artifacts.mjs",
    "generate": "node ./scripts/generate-library.mjs && node ./scripts/generate-explorer-css.mjs",
    "build": "npm run clean && npm run generate && tsc && tsc -p src/explorer.tsconfig.json",
    "bundle": "npm run build && npm run svg:render && node ./scripts/generate-browser.mjs && npx rollup -c ./build/config/rollup.config.js --silent && node ./scripts/generate-type-declarations.mjs",
    "prepublishOnly": "npm run bundle",
    "start": "vite --config ./config/vite.config.js",
    "pretest": "npm run format && node ./scripts/ensure-test-bundle.mjs && npm run demo:locales -- build/demo-pages && npm run demo:pwa -- build/demo-pages/service-worker.js",
    "test": "npm run pretest && vitest --run",
    "test:coverage": "npm run pretest && vitest --run --coverage",
    "test:watch": "vitest",
    "format": "script -q /dev/null prettier --write . --ignore-unknown --cache | awk '!/ \\(unchanged\\)/'",
    "format:check": "prettier --check . --ignore-unknown",
    "demo:locales": "node ./scripts/generate-demo-pages.mjs build/demo-pages",
    "demo:pwa": "node ./scripts/generate-service-worker.mjs",
    "demo:validate": "node ./scripts/validate-pages-site.mjs",
    "svg:render": "node ./scripts/render-svg-assets.mjs",
    "website:build": "node ./scripts/publish-website.mjs",
    "website:publish": "node ./scripts/publish-website.mjs --publish",
    "website:staging": "node ./scripts/stage-website.mjs",
    "pixel-font:generate": "node ./pixel-font/scripts/generate-atlases.mjs",
    "pixel-font:build": "node ./pixel-font/scripts/build-assets.mjs",
    "pixel-font:build:optimized": "node ./pixel-font/scripts/build-assets.mjs --optimize",
    "pixel-font:package": "node ./pixel-font/scripts/build-assets.mjs --fonts-only --optimize && node ./pixel-font/scripts/package-font.mjs",
    "pixel-font:text": "node ./pixel-font/scripts/build-retro-text-font.mjs",
    "pixel-font:text:bootstrap": "node ./pixel-font/scripts/bootstrap-retro-text-source.mjs",
    "pixel-font:text:extract": "node ./pixel-font/scripts/extract-retro-text-source.mjs",
    "pixel-font:version": "node ./pixel-font/scripts/version-font.mjs",
    "pixel-font:validate": "node ./pixel-font/scripts/validate-atlases.mjs",
    "unicode": "node ./scripts/update-unicode.mjs",
    "unicode:proposed": "node ./scripts/download-proposed-unicode.mjs",
    "versions:snapshot": "node ./scripts/update-version-export-snapshot.mjs",
    "cldr": "node ./scripts/update-cldr-locales.mjs && npm run format",
    "locales:overrides": "node ./scripts/apply-locale-label-overrides.mjs && npm run format",
    "locales:newspeak": "node ./scripts/generate-newspeak-locale.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lewismoten/emoji.git"
  },
  "keywords": [
    "emoji",
    "unicode",
    "icons",
    "emoticons",
    "emote"
  ],
  "author": "Lewis Moten",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/lewismoten/emoji/issues"
  },
  "homepage": "https://github.com/lewismoten/emoji#readme",
  "devDependencies": {
    "@codejamboree/js-logger": "^2.2.3",
    "@codejamboree/web-request-queue": "^3.2.0",
    "@resvg/resvg-js": "^2.6.2",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "prettier": "3.9.6",
    "rollup": "^4.22.5",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
