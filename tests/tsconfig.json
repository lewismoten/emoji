{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "ignoreDeprecations": "6.0",
    "baseUrl": "..",
    "paths": {
      "@codejamboree/web-request-queue": ["./types/web-request-queue.d.ts"],
      "@lewismoten/emoji/search": ["./library/search.ts"]
    },
    "rootDir": "..",
    "outDir": "../build",
    "sourceMap": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["./**/*.mts"],
  "exclude": ["./package-exports.test.mts"]
}
